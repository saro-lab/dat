<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net8.0 is the current LTS; net10.0 gets the built-in Base64Url.
             DatUtils shims Base64Url for net8.0, see DatUtils.cs. -->
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>saro-dat</PackageId>
        <Version>4.6.1</Version>
        <Authors>Marker Seoul</Authors>
        <Company>SARO</Company>

        <PackageTags>dat;distributed;access;token;jwt;security;authentication</PackageTags>

        <PackageProjectUrl>https://dat.saro.me</PackageProjectUrl>
        <RepositoryUrl>https://github.com/saro-lab/dat</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageReadmeFile>README.md</PackageReadmeFile>

        <Description>Distributed Access Token</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Saro.Dat.Tests</_Parameter1> </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    </ItemGroup>

</Project>
